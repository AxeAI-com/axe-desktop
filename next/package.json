{
  "name": "axe-desktop",
  "productName": "Axe AI",
  "version": "0.9.0",
  "description": "Axe AI for Mac, Windows and Linux: every model, your own CLIs, and an agent that works on your computer.",
  "author": {
    "name": "Axe AI",
    "email": "hello@axeai.com"
  },
  "homepage": "https://axeai.com/download",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/build-hands.mjs && electron-vite dev",
    "build": "node scripts/build-hands.mjs && electron-vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "check": "scripts/check",
    "test:e2e": "playwright test",
    "snapshots:optimize": "scripts/optimize-snapshots.sh",
    "pack:mac": "electron-vite build && electron-builder --mac --dir --publish never",
    "release:mac": "node scripts/build-hands.mjs && electron-vite build && electron-builder --mac zip dmg --arm64 --x64 --publish never && codesign --verify --deep --strict 'dist/mac-arm64/Axe AI.app' 'dist/mac/Axe AI.app'",
    "release:win": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "release:linux": "electron-vite build && electron-builder --linux AppImage deb --x64 --publish never",
    "sign:release": "node scripts/sign-update.ts dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@solar-icons/react": "2.3.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.3",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "prism-react-renderer": "2.4.1",
    "recharts": "3.10.1",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "30.1.3",
    "motion": "13.4.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.axeai.desktop",
    "productName": "Axe AI",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "resources/tray*.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "protocols": [
      {
        "name": "Axe AI sign-in",
        "schemes": [
          "axedesktop"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dir"
      ],
      "extraResources": [
        {
          "from": "resources/axe-hands",
          "to": "axe-hands"
        },
        {
          "from": "resources/axe-speech",
          "to": "axe-speech"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Axe AI listens only while you dictate or talk to it."
      },
      "artifactName": "Axe-AI-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Axe-AI-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Axe-AI-${version}-${arch}.${ext}"
    },
    "icon": "resources/icon.png",
    "afterPack": "scripts/mac-icon.mjs",
    "publish": [
      {
        "provider": "generic",
        "url": "https://axeai.com/downloads/desktop"
      }
    ],
    "dmg": {
      "artifactName": "Axe-AI-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Axe AI"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
